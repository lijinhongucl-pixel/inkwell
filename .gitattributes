# 统一换行符：仓库内一律 LF，避免 Windows 上 checkout 出 CRLF 导致测试/快照对比失败
* text=auto eol=lf

# 明确文本类型
*.py      text diff=python
*.md      text
*.toml    text
*.yml     text
*.yaml    text
*.json    text
*.js      text
*.html    text
*.css     text

# 二进制，禁止换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary

# 锁文件不参与 diff 统计
uv.lock   linguist-generated
