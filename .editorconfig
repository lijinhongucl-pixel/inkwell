# 编辑器与 IDE 的跨项目统一约定
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,css,html}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是「硬换行」语法，不能裁掉
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
